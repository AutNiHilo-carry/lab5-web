# 服务端口
PORT=3000
HOST=127.0.0.1

# 数据库连接
# 本项目已在 C:\lab5-mysql 装好 MySQL 8.0.29（免安装版，端口 3307，root 空密码），
# 用 lab5-web\启动数据库.bat 启动即可，不需要改下面各项。
# 如果你用自己已有的 MySQL（默认 3306），把 DB_PORT 改成对应端口即可。
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=lab5_mes
DB_POOL=10

# 设为 true 时不连数据库，直接用内存演示数据（没有 MySQL 时的应急模式）
USE_MEMORY=false
